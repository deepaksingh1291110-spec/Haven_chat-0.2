<?xml version="1.0" encoding="utf-8"?>
<!--
  =====================================================================
  AndroidManifest.xml  (app/src/main/)
  WHAT: The app's "ID card" for Android. It says what the app is called,
        which screen opens first, and which permissions it needs.

  PRIVATE MODELS: THE APP NEEDS NO PERMISSIONS ANY MORE.
        Before, this file asked for "All files access"
        (MANAGE_EXTERNAL_STORAGE) and READ_EXTERNAL_STORAGE, because the
        model files (GGUF) were read from a normal phone folder. The Play
        Store does not like that permission.
        Now the user adds a model with Android's own file picker, and the
        app COPIES it into its private space (see ModelStore.kt). The
        picker gives the app access to the ONE file the user chose, and the
        private folder needs no permission. So both permissions are gone.
  =====================================================================
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="Haven Chat"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Haven.Splash">
        <!-- The theme above is a plain built-in one with no top bar.
             Our real look (colors, dark/light) is drawn by Jetpack Compose
             inside MainActivity, so we do not need a custom XML theme. -->

        <!-- MainActivity = the one and only Android "screen" (Activity).
             All our screens (chat, drawer, settings, privacy, models) live
             INSIDE it as Compose screens. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <!-- adjustResize: the chat input bar moves up with the keyboard. -->

            <!-- This block marks it as the screen that opens when the user
                 taps the app icon. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
